include scripts/install_plip_wsl.sh
include scripts/prepare_ligand_complexes.py
include scripts/pdb_to_arpeggio_cif.py
include scripts/discovery_studio_batch_interactions.pl
prune vendor
global-exclude __pycache__ *.py[cod]
